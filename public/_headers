# HTML: never long-cached (pages are regenerated by CI), but MUST be edge-cacheable
# with stale-if-error so a failing origin serves stale HTML instead of a 504.
# (26 Nov 2026 — 11,361 x 504 on 25 Nov, ~= the cache-miss count: no-store forced
# every HTML request to origin. Same fix that already cured the sitemap 204/504 flap.)
/*.html
  Cache-Control: public, max-age=0, s-maxage=300, stale-while-revalidate=86400, stale-if-error=86400

/
  Cache-Control: public, max-age=0, s-maxage=300, stale-while-revalidate=86400, stale-if-error=86400

/*/
  Cache-Control: public, max-age=0, s-maxage=300, stale-while-revalidate=86400, stale-if-error=86400

# Immutable static assets
/icons/*
  Cache-Control: public, max-age=31536000, immutable
/theme.css
  Cache-Control: public, max-age=604800
/mapapp.js
  Cache-Control: public, max-age=604800
/favicon.svg
  Cache-Control: public, max-age=31536000, immutable

# Data + sitemaps always fresh
/data/*
  Cache-Control: public, max-age=300
/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600, s-maxage=86400

# Child sitemaps had max-age=0, must-revalidate -> every request hit origin,
# which is what produced the 204/504 flapping on sitemap fetches.
/sitemap/*.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600, s-maxage=86400
/robots.txt
  Cache-Control: public, max-age=600

# Internal console — never indexed
/themes/
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
