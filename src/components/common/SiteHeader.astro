---
const path = Astro.url.pathname;
const isHome = path === '/';
---
<header class="site-header">
  <div class="wrap header-inner">
    <a href="/" class="brand" aria-label="Toilets Near Me — home">
      <img src="/favicon.svg" alt="" width="40" height="40" />
      <span>Toilets Near Me</span>
    </a>

    <button type="button" class="nav-toggle" aria-expanded="false" aria-controls="primary-nav" data-nav-toggle>
      <span class="sr-only">Menu</span>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
    </button>

    <nav id="primary-nav" class="primary-nav" aria-label="Main navigation">
      <a href="/#cities">Cities</a>
      <a href="/#how">How it works</a>
      <a href="/about/">About</a>
      <a href="/privacy/">Privacy</a>
      {!isHome && <a class="nav-cta" href="/#cities">Find toilets near me</a>}
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 30;
    background: rgba(255,255,255,.92);
    backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid var(--color-line);
  }
  .header-inner { display: flex; align-items: center; gap: 16px; min-height: 68px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; font-size: 18px; font-weight: 700; letter-spacing: -.02em; }
  .brand img { border-radius: 12px; }
  .nav-toggle {
    margin-left: auto; display: inline-grid; place-items: center;
    width: 44px; height: 44px; border-radius: 12px;
    border: 1px solid var(--color-line); background: #fff; color: var(--color-ink); cursor: pointer;
  }
  .primary-nav { display: none; }
  .primary-nav.is-open {
    display: flex; flex-direction: column; gap: 4px;
    position: absolute; left: 0; right: 0; top: 100%;
    background: #fff; border-bottom: 1px solid var(--color-line);
    padding: 10px 4%; box-shadow: 0 12px 24px rgba(15,23,42,.08);
  }
  .primary-nav a { padding: 11px 8px; border-radius: 10px; font-size: 15px; font-weight: 500; color: var(--color-muted); }
  .primary-nav a:hover { color: var(--color-green-dark); background: var(--color-mint-soft); }
  .nav-cta { background: var(--color-green); color: #fff !important; font-weight: 600 !important; text-align: center; margin-top: 4px; }
  .nav-cta:hover { background: var(--color-green-dark); }

  @media (min-width: 860px) {
    .nav-toggle { display: none; }
    .primary-nav { display: flex !important; align-items: center; gap: 6px; margin-left: auto; position: static; padding: 0; box-shadow: none; border: 0; background: transparent; }
    .primary-nav a { padding: 8px 12px; font-size: 14px; }
    .nav-cta { margin-top: 0; padding: 10px 16px !important; border-radius: 10px; }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const nav = document.getElementById('primary-nav');
  if (toggle && nav) {
    toggle.addEventListener('click', () => {
      const open = nav.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded', String(open));
    });
    nav.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).tagName === 'A') {
        nav.classList.remove('is-open');
        toggle.setAttribute('aria-expanded', 'false');
      }
    });
  }
</script>
