---
import Base from '../layouts/Base.astro';
const site = 'https://toiletsnearme.pages.dev';
---
<Base
  title="Privacy — Toilets Near Me"
  description="What Toilets Near Me collects, why, and how to opt out. No account, no selling of data, no fingerprinting."
  canonical={site + '/privacy/'}
  jsonld={[{ '@context': 'https://schema.org', '@type': 'WebPage', name: 'Privacy — Toilets Near Me', url: site + '/privacy/' }]}
>
  <section class="page-hero">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">Privacy</span></nav>
      <h1>Privacy</h1>
      <p class="lead">The short version: no account, nothing sold, and no personal details required to use the maps.</p>
    </div>
  </section>

  <section class="wrap prose">
    <h2>What we collect</h2>
    <p>
      Aggregate analytics through Google Analytics 4 — pages viewed, approximate country, and device type. Google
      Analytics sets cookies; you can block them in your browser without losing any functionality on this site.
    </p>
    <p>
      We do not collect names, phone numbers, email addresses or precise location. Your location is only used inside
      your own browser when you press "Use my location" — it is not sent to us or stored.
    </p>

    <h2>What we do not do</h2>
    <ul>
      <li>No accounts, no logins, no newsletter signup.</li>
      <li>No session identifiers or browser fingerprinting.</li>
      <li>No referrer logging beyond what standard analytics records.</li>
      <li>No selling or sharing of data with third parties for their own purposes.</li>
    </ul>

    <h2>Third parties</h2>
    <ul>
      <li><strong>OpenStreetMap</strong> — map tiles and facility data.</li>
      <li><strong>Google Analytics</strong> — aggregate usage statistics.</li>
      <li><strong>Monetag</strong> — advertising, where ads are shown.</li>
      <li><strong>Cloudflare</strong> — hosting and delivery.</li>
    </ul>

    <h2>Your rights</h2>
    <p>
      Write to <a href="mailto:skmstudio.services@gmail.com">skmstudio.services@gmail.com</a> to ask what is held
      about you, or to have it removed.
    </p>

    <h2>Changes</h2>
    <p>If this policy changes, the updated version appears on this page.</p>
    <p class="fineprint">Data © OpenStreetMap contributors, available under the Open Database Licence.</p>
  </section>
</Base>

<style>
  .page-hero { background: radial-gradient(700px 240px at 20% -20%, var(--color-mint) 0%, transparent 70%); border-bottom: 1px solid var(--color-line); padding: 30px 0 26px; }
  .crumbs { display: flex; gap: 8px; font-size: 13px; color: var(--color-muted); }
  .crumbs a { text-decoration: underline; text-underline-offset: 2px; }
  .page-hero h1 { margin: 10px 0 0; font-size: clamp(26px, 4.4vw, 38px); }
  .lead { margin: 10px 0 0; color: var(--color-muted); max-width: 62ch; font-size: 16px; }
  .prose { max-width: 74ch; padding-top: 30px; }
  .prose h2 { font-size: 19px; margin: 28px 0 8px; }
  .prose p { margin: 0 0 12px; font-size: 15px; color: var(--color-muted); line-height: 1.7; }
  .prose ul { margin: 0 0 12px; padding-left: 20px; display: grid; gap: 8px; font-size: 15px; color: var(--color-muted); }
  .prose strong { color: var(--color-ink); }
  .prose a { color: var(--color-green-dark); text-decoration: underline; }
  .fineprint { font-size: 13px !important; }
</style>
