---
import Base from '../../layouts/Base.astro';
import FacilityMap from '../../components/map/FacilityMap.astro';
import { getAllCities, getCityFacilities, nearbyCities } from '../../lib/cities';

export function getStaticPaths() {
  return getAllCities().map((c) => ({ params: { city: c.slug }, props: { city: c } }));
}

const { city } = Astro.props as any;
const facilities = getCityFacilities(city.slug);
const nearby = nearbyCities(city.slug, 8);

const site = 'https://toiletsnearme.pages.dev';
const url = `${site}/${city.slug}/`;
// ── A/B test: three metadata + H1 patterns, split deterministically by slug ──
// Deterministic so a crawler always sees the same variant for the same URL.
// The variant is recorded in the page HTML (data-variant) so GSC/GA can segment it.
const _h = [...city.slug].reduce((a, c) => (a * 31 + c.charCodeAt(0)) >>> 0, 7);
const variant = ['A', 'B', 'C'][_h % 3];

const VARIANTS = {
  A: {
    title: `Public toilets near me in ${city.name} — Live Map`,
    description: `Public toilets near me in ${city.name}: ${city.count.toLocaleString('en-IN')} mapped, ${city.free} free, ${city.open24} open 24 hours. Tap a pin for directions.`,
    h1: `Public toilets near me in ${city.name}`,
  },
  B: {
    title: `Public toilets in ${city.name} — All Locations, Live Map`,
    description: `All mapped public toilets in ${city.name} — free vs paid, 24-hour and wheelchair-accessible, with directions. ${city.count.toLocaleString('en-IN')} facilities on a live map.`,
    h1: `Public toilets in ${city.name}`,
  },
  C: {
    title: `Where are the public toilets in ${city.name}? — Map`,
    description: `Looking for a public toilet in ${city.name}? ${city.count.toLocaleString('en-IN')} mapped facilities, ${city.free} free to use, ${city.open24} open around the clock. Live map.`,
    h1: `Where are the public toilets in ${city.name}?`,
  },
} as const;

const v = VARIANTS[variant as keyof typeof VARIANTS];
const title = v.title;
const description = v.description;

const jsonld = [
  {
    '@context': 'https://schema.org', '@type': 'WebPage', name: title, description, url,
    isPartOf: { '@type': 'WebSite', name: 'Toilets Near Me', url: site + '/' },
    about: { '@type': 'Place', name: city.name, geo: { '@type': 'GeoCoordinates', latitude: city.lat.toFixed(4), longitude: city.lon.toFixed(4) } },
  },
  {
    '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: [
      { '@type': 'Question', name: `How many public toilets are mapped in ${city.name}?`,
        acceptedAnswer: { '@type': 'Answer', text: `${city.count.toLocaleString('en-IN')} public toilets and washrooms are mapped in ${city.name} on OpenStreetMap.` } },
      { '@type': 'Question', name: `Are public toilets in ${city.name} free?`,
        acceptedAnswer: { '@type': 'Answer', text: `${city.free} mapped facilities are tagged free to use and ${city.paid} are pay-and-use, typically ₹5–₹10.` } },
      { '@type': 'Question', name: `Are there wheelchair-accessible toilets in ${city.name}?`,
        acceptedAnswer: { '@type': 'Answer', text: `${city.wheelchair} mapped facilities in ${city.name} are tagged wheelchair-accessible.` } },
      { '@type': 'Question', name: `Are any toilets in ${city.name} open 24 hours?`,
        acceptedAnswer: { '@type': 'Answer', text: `${city.open24} mapped facilities in ${city.name} are tagged as open 24 hours.` } },
    ],
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'All cities', item: site + '/' },
      { '@type': 'ListItem', position: 2, name: city.name, item: url },
    ],
  },
];

const rows = [
  ['Free entry', city.free],
  ['Paid (₹5–10 typical)', city.paid],
  ['Open 24 hours', city.open24],
  ['Wheelchair accessible', city.wheelchair],
  ["Women's section", city.women],
  ['Baby changing', city.baby],
  ['Named facility', city.named],
  ['Customers only', city.customers],
].filter(([, n]) => (n as number) > 0);

const pct = (n: number) => (city.count ? Math.round((n / city.count) * 100) : 0);
---
<Base title={title} description={description} canonical={url} jsonld={jsonld} ogImage={`/og/${city.slug}.png`} dataVariant={variant}>
  <section class="city-hero">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">All cities</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{city.name}</span>
      </nav>
      <h1>{v.h1}</h1>
      <p class="city-sub">
        {city.count.toLocaleString('en-IN')} public toilets and washrooms mapped across {city.name}.
        Filter by what you need, tap a pin for details. Data © OpenStreetMap contributors.
      </p>
      <ul class="city-badges">
        <li><strong>{city.free.toLocaleString('en-IN')}</strong> free</li>
        <li><strong>{city.wheelchair.toLocaleString('en-IN')}</strong> wheelchair accessible</li>
        <li><strong>{city.open24.toLocaleString('en-IN')}</strong> open 24h</li>
        <li><strong>{city.women.toLocaleString('en-IN')}</strong> women's section</li>
      </ul>
    </div>
  </section>

  <section class="wrap section">
    <h2 class="sr-only">Map of public toilets in {city.name}</h2>
    <FacilityMap facilities={facilities} label={`public toilets in ${city.name}`} height="lg" />
  </section>

  <section class="wrap section">
    <div class="two-col">
      <div>
        <h2>What you'll actually find in {city.name}</h2>
        <p class="section-sub">Counted from OpenStreetMap tags. A low number means "not recorded yet" — not "not there".</p>
        <div class="card table-card">
          <table>
            <caption class="sr-only">Facility features recorded for {city.name}</caption>
            <thead><tr><th scope="col">Feature</th><th scope="col">Reported</th><th scope="col">Share</th></tr></thead>
            <tbody>
              {rows.map(([label, n]) => (
                <tr>
                  <th scope="row">{label}</th>
                  <td>{(n as number).toLocaleString('en-IN')} of {city.count.toLocaleString('en-IN')}</td>
                  <td><span class="bar"><i style={`width:${pct(n as number)}%`}></i></span></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <aside class="side-notes">
        <h2>Practical notes for {city.name}</h2>
        <ul>
          <li><strong>Malls and metro stations</strong> usually have the cleanest free facilities.</li>
          <li><strong>Pay-and-use complexes</strong> charge ₹5–₹10 and are attended.</li>
          <li><strong>Petrol pumps and hospitals</strong> are the most reliable overnight options.</li>
          <li>Tap any pin on the map to open the exact location in OpenStreetMap.</li>
        </ul>
        <p class="side-cta"><a href="/#cities">Browse all cities →</a></p>
      </aside>
    </div>
  </section>


  <section class="wrap section">
    <h2>Nearby cities</h2>
    <p class="section-sub">The closest mapped cities to {city.name}, by distance — useful if you are travelling between them.</p>
    <ul class="nearby">
      {nearby.map(({ city: n, km }) => (
        <li>
          <a href={`/${n.slug}/`}>{n.name}</a>
          <span class="nb-meta">{km.toLocaleString('en-IN')} km away · {n.count.toLocaleString('en-IN')} mapped · {n.free.toLocaleString('en-IN')} free</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="wrap section">
    <div class="share">
      <p class="share-label">Know someone in {city.name}? Send them this map.</p>
      <div class="share-actions">
        <a class="share-btn" rel="nofollow noopener" target="_blank"
           href={`https://wa.me/?text=${encodeURIComponent(`Public toilets in ${city.name} — ${city.count} mapped, ${city.free} free. Live map: ${url}`)}`}
           data-track="share:whatsapp">WhatsApp</a>
        <a class="share-btn" rel="nofollow noopener" target="_blank"
           href={`https://x.com/intent/tweet?text=${encodeURIComponent(`Public toilets in ${city.name} — ${city.count} mapped, ${city.free} free`)}&url=${encodeURIComponent(url)}`}
           data-track="share:x">Post on X</a>
        <a class="share-btn" rel="nofollow noopener" target="_blank"
           href={`https://www.reddit.com/submit?url=${encodeURIComponent(url)}&title=${encodeURIComponent(`Public toilets in ${city.name} — ${city.count} mapped`)}`}
           data-track="share:reddit">Reddit</a>
        <button type="button" class="share-btn" data-copy-link={url} data-track="share:copy">Copy link</button>
      </div>
    </div>
  </section>

  <section class="wrap section">
    <h2>Public toilets in {city.name} — FAQ</h2>
    <div class="faq">
      <details class="card"><summary>How many public toilets are mapped in {city.name}?</summary>
        <p>{city.count.toLocaleString('en-IN')} facilities are mapped on OpenStreetMap in {city.name}.</p></details>
      <details class="card"><summary>Are public toilets in {city.name} free?</summary>
        <p>{city.free.toLocaleString('en-IN')} are tagged free and {city.paid.toLocaleString('en-IN')} are pay-and-use, typically ₹5–₹10.</p></details>
      <details class="card"><summary>Are there wheelchair-accessible toilets in {city.name}?</summary>
        <p>{city.wheelchair.toLocaleString('en-IN')} mapped facilities are tagged wheelchair-accessible.</p></details>
      <details class="card"><summary>Which toilets in {city.name} are open at night?</summary>
        <p>{city.open24.toLocaleString('en-IN')} mapped facilities are tagged as open 24 hours. Petrol pumps and hospitals are the most dependable overnight options.</p></details>
    </div>
  </section>
</Base>

<style>
  .city-hero {
    background: radial-gradient(760px 260px at 20% -20%, var(--color-mint) 0%, transparent 70%);
    border-bottom: 1px solid var(--color-line);
    padding: 30px 0 26px;
  }
  .crumbs { display: flex; gap: 8px; font-size: 13px; color: var(--color-muted); }
  .crumbs a { text-decoration: underline; text-underline-offset: 2px; }
  .city-hero h1 { margin: 10px 0 0; font-size: clamp(26px, 4.4vw, 40px); }
  .city-sub { margin: 10px 0 0; max-width: 68ch; color: var(--color-muted); font-size: 15px; }
  .city-badges { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; margin: 16px 0 0; padding: 0; }
  .city-badges li {
    background: #fff; border: 1px solid var(--color-line); border-radius: 999px;
    padding: 6px 12px; font-size: 13px; color: var(--color-muted);
  }
  .city-badges strong { color: var(--color-ink); }

  .section { padding: 34px 0 0; }
  .section-sub { margin: 6px 0 16px; color: var(--color-muted); font-size: 14px; }
  .two-col { display: grid; gap: 26px; }
  .table-card { overflow: hidden; }
  table { width: 100%; border-collapse: collapse; font-size: 14px; }
  thead th {
    background: var(--color-mint-soft); text-align: left; font-size: 12px;
    letter-spacing: .06em; text-transform: uppercase; color: var(--color-green-deep);
    padding: 10px 14px;
  }
  tbody th, tbody td { padding: 11px 14px; border-top: 1px solid var(--color-line); text-align: left; font-weight: 500; }
  tbody th { font-weight: 600; }
  tbody td { color: var(--color-muted); }
  .bar { display: block; width: 90px; height: 6px; border-radius: 999px; background: var(--color-line); overflow: hidden; }
  .bar i { display: block; height: 100%; background: var(--color-green); }

  .side-notes { background: #fff; border: 1px solid var(--color-line); border-radius: var(--radius-card); padding: 22px; align-self: start; }
  .side-notes h2 { font-size: 17px; }
  .side-notes ul { margin: 12px 0 0; padding-left: 18px; display: grid; gap: 10px; font-size: 14px; color: var(--color-muted); }
  .side-notes strong { color: var(--color-ink); }
  .side-cta { margin: 16px 0 0; font-size: 14px; font-weight: 600; }
  .side-cta a { color: var(--color-green-dark); }

  .faq { display: grid; gap: 10px; margin-top: 16px; }
  .faq details { padding: 16px 18px; }
  .faq summary { cursor: pointer; font-weight: 600; font-size: 15px; }
  .faq summary::marker { color: var(--color-green); }
  .faq p { margin: 10px 0 0; font-size: 14px; color: var(--color-muted); }

  .nearby { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); }
  .nearby li { background: #fff; border: 1px solid var(--color-line); border-radius: 12px; padding: 12px 14px; display: grid; gap: 2px; }
  .nearby a { font-weight: 600; font-size: 15px; color: var(--color-ink); text-decoration: underline; text-underline-offset: 2px; text-decoration-color: transparent; }
  .nearby a:hover { color: var(--color-green-dark); text-decoration-color: currentColor; }
  .nb-meta { font-size: 12.5px; color: var(--color-muted); }

  .share { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; justify-content: space-between;
    background: #fff; border: 1px solid var(--color-line); border-radius: var(--radius-card); padding: 16px 18px; }
  .share-label { margin: 0; font-size: 14px; font-weight: 600; }
  .share-actions { display: flex; flex-wrap: wrap; gap: 8px; }
  .share-btn {
    display: inline-flex; align-items: center; min-height: 40px; padding: 0 14px;
    border: 1px solid var(--color-line); border-radius: 10px; background: #fff;
    font: inherit; font-size: 13px; font-weight: 600; color: var(--color-ink); cursor: pointer;
  }
  .share-btn:hover { border-color: var(--color-green); color: var(--color-green-dark); }

  @media (min-width: 900px) { .two-col { grid-template-columns: 1.7fr 1fr; } }
</style>
